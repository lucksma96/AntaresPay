<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AntaresPay.RegisterPage"
             xmlns:viewmodel="clr-namespace:AntaresPay.ViewModels"
             x:DataType="viewmodel:RegisterViewModel"
             Title="Register">
    <VerticalStackLayout>
        <Label 
            Text="Selecione a unidade"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Picker Title="Unidade" ItemsSource="{Binding Units}" ItemDisplayBinding="{Binding Name}"></Picker>
        <Button Text="Confirmar"></Button>
    </VerticalStackLayout>
</ContentPage>