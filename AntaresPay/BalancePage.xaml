<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AntaresPay.BalancePage"
             xmlns:viewmodel="clr-namespace:AntaresPay.ViewModels"
             x:DataType="viewmodel:BalanceViewModel"
             Title="Extrato">
    <VerticalStackLayout Padding="10" Spacing="10">
        <Label 
            Text="{Binding UnitData.Name}"
            FontSize="32"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label 
            Text="{Binding UnitData.Balance, StringFormat='₳ {0:D}'}"
            FontSize="28"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button Text="OK" FontSize="24"></Button>
    </VerticalStackLayout>
</ContentPage>