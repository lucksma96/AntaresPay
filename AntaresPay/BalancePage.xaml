<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AntaresPay.BalancePage"
             xmlns:viewmodel="clr-namespace:AntaresPay.ViewModels"
             x:DataType="viewmodel:BalanceViewModel"
             Title="Extrato">
    <VerticalStackLayout Padding="30" Spacing="10">
        <HorizontalStackLayout>
            <Label Text="Unidade: " FontSize="32"></Label>
            <Label Text="{Binding UnitData.Name}" FontSize="32" VerticalOptions="Center" HorizontalOptions="Start" />
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <Label Text="Saldo: " FontSize="28"></Label>
            <Label Text="{Binding UnitData.Balance, StringFormat='₳{0:D}'}" FontSize="28" VerticalOptions="Center" HorizontalOptions="Start" />
        </HorizontalStackLayout>
        <Label Text="Aproxime o cartão" FontSize="16" HorizontalOptions="Center"></Label>
        <Button Text="Voltar" FontSize="24" Command="{Binding ReturnCommand}"></Button>
    </VerticalStackLayout>
</ContentPage>