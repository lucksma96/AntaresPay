<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AntaresPay"
             x:Class="AntaresPay.MainPage">

    <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
        <Image
                Source="logo.png"
                BackgroundColor="Transparent"
                HeightRequest="200"
                Aspect="AspectFit"
                SemanticProperties.Description="Logo Antares" />

        <Label
                Text="AntaresPay"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

        <Label
                Text="Selecione a operação"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Select monetary operation" />

        <VerticalStackLayout Spacing="10">
            <Button Text="Pagar" Clicked="OperationButtons_Clicked"></Button>
            <Button Text="Cobrar" Clicked="OperationButtons_Clicked"></Button>
            <Button Text="Extrato" Clicked="BalanceButton_Clicked"></Button>
            <Button Text="Registrar" Clicked="RegisterButton_Clicked"></Button>
        </VerticalStackLayout>
    </VerticalStackLayout>

</ContentPage>
