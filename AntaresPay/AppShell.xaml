<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AntaresPay.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AntaresPay"
    Shell.FlyoutBehavior="Flyout"
    Title="AntaresPay">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="Todas Operações"
        ContentTemplate="{DataTemplate local:AllOperationsPage}"
        Route="AllOperationsPage" />

</Shell>
