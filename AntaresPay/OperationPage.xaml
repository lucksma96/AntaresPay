<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AntaresPay.OperationPage"
             xmlns:local="clr-namespace:AntaresPay"
             xmlns:viewmodel="clr-namespace:AntaresPay"
             x:DataType="viewmodel:OperationViewModel"
             Title="{Binding Operation}">
    <Grid ColumnDefinitions=".33*, .33*, .33*" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto" Padding="10" ColumnSpacing="15" RowSpacing="15">
        <Border Stroke="DarkGray" StrokeLineJoin="Round" Grid.ColumnSpan="3">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5" />
            </Border.StrokeShape>
            <Label Text="{Binding Value, StringFormat='₳ {0:D}'}" HorizontalTextAlignment="End" VerticalTextAlignment="Center" FontSize="28" Padding="10,0"></Label>
        </Border>
        <Button Text="LIMPAR" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Command="{Binding ClearCommand}" />
        <Button Text="&#x21E6;" FontSize="24" Grid.Row="1" Grid.Column="2" Command="{Binding BackspaceCommand}" />
        <Button Text="7" FontSize="24" Grid.Column="0" Grid.Row="2" Command="{Binding RegisterInputCommand}" CommandParameter="7"></Button>
        <Button Text="8" FontSize="24" Grid.Column="1" Grid.Row="2" Command="{Binding RegisterInputCommand}" CommandParameter="8"></Button>
        <Button Text="9" FontSize="24" Grid.Column="2" Grid.Row="2" Command="{Binding RegisterInputCommand}" CommandParameter="9"></Button>
        <Button Text="4" FontSize="24" Grid.Column="0" Grid.Row="3" Command="{Binding RegisterInputCommand}" CommandParameter="4"></Button>
        <Button Text="5" FontSize="24" Grid.Column="1" Grid.Row="3" Command="{Binding RegisterInputCommand}" CommandParameter="5"></Button>
        <Button Text="6" FontSize="24" Grid.Column="2" Grid.Row="3" Command="{Binding RegisterInputCommand}" CommandParameter="6"></Button>
        <Button Text="1" FontSize="24" Grid.Column="0" Grid.Row="4" Command="{Binding RegisterInputCommand}" CommandParameter="1"></Button>
        <Button Text="2" FontSize="24" Grid.Column="1" Grid.Row="4" Command="{Binding RegisterInputCommand}" CommandParameter="2"></Button>
        <Button Text="3" FontSize="24" Grid.Column="2" Grid.Row="4" Command="{Binding RegisterInputCommand}" CommandParameter="3"></Button>
        <Button Text="0" FontSize="24" Grid.Row="5" Grid.ColumnSpan="3" Command="{Binding RegisterInputCommand}" CommandParameter="0"></Button>
        <Button Text="Cancelar" Grid.Column="0" Grid.ColumnSpan="1" Grid.Row="6" Command="{Binding ReturnCommand}"></Button>
        <Button Text="Confirmar" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="6" Command="{Binding GoToTransactionCommand}"></Button>
    </Grid>
</ContentPage>